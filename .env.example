# קול טבעי לביפ — העתיקו לקובץ .env (לא נשמר ב-git) והדביקו מפתח.
# Google Cloud Text-to-Speech (קולות Chirp 3 HD — מומלץ)
GOOGLE_TTS_KEY=

# אופציונלי: Microsoft Azure במקום Google
# TTS_PROVIDER=azure
# AZURE_TTS_KEY=
# AZURE_TTS_REGION=westeurope

# אופציונלי: קול ברירת מחדל (ברירת המחדל: Wavenet-B; אפשר גם Wavenet-A/C/D או קולות Chirp כמו Charon)
# TTS_DEFAULT_VOICE=Wavenet-B
